# ── DATABASE ──────────────────────────────────────────────────────
# Railway → Postgres → Connect tab → copy DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── SECURITY ──────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ── AI ────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── EMAIL ─────────────────────────────────────────────────────────
# resend.com → free 3000 emails/month
RESEND_API_KEY=re_your-resend-key
ADMIN_EMAIL=cybersafari54@gmail.com

# ── M-PESA ────────────────────────────────────────────────────────
# developer.safaricom.co.ke → register free
# Fee goes to Larry's number below
ADMIN_MPESA_NUMBER=254790091529
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
# Your Railway URL + /payments/mpesa/callback
MPESA_CALLBACK_URL=https://your-app.railway.app/payments/mpesa/callback

# ── PAYPAL ────────────────────────────────────────────────────────
# developer.paypal.com → free sandbox then go live
# Fee goes to cybersafari54@gmail.com
ADMIN_PAYPAL_EMAIL=cybersafari54@gmail.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ── BITCOIN ───────────────────────────────────────────────────────
# Your BTC wallet address from Coinbase/Binance
ADMIN_BTC_ADDRESS=your-btc-wallet-address

# ── FRONTEND ──────────────────────────────────────────────────────
FRONTEND_URL=https://apexsafari.netlify.app
